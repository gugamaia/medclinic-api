# Servidor
PORT=3000
LOG_LEVEL=log

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=medclinic
DB_SYNCHRONIZE=false
DB_LOG_LEVEL=error
DB_SSL=false

# JWT
JWT_SECRET=troque-esta-chave-em-producao-para-um-valor-bem-forte
JWT_EXPIRES_IN=8h
JWT_ISSUER=medclinic

# Primeiro administrador (criado pelo script de seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@medclinic.com
ADMIN_PASSWORD=TrocarSenhaForte@123

# Containers (Docker Compose)
CONTAINER_NAME_DB=medclinic-postgres
CONTAINER_NAME_API=medclinic-api
